# ---- Backend (backend/) -------------------------------------------------
# Port for the API + Socket.IO server in development (default 4000).
API_PORT=4000
# In production most hosts inject PORT; it is only honoured when NODE_ENV=production.
# PORT=8080
# NODE_ENV=production

# Comma-separated list of browser origins allowed to connect (CORS + Socket.IO).
# Leave empty in development. In production, if empty, cross-origin access is denied
# (same-origin still works when the backend serves the frontend via STATIC_DIR).
CLIENT_ORIGINS=

# Optional. When unset (or unreachable) race history is kept in memory.
# MONGODB_URI=mongodb://localhost:27017/keyrush

# Optional. Serve the built frontend from the backend (single-service deploy).
# STATIC_DIR=../frontend/dist

# ---- Frontend (frontend/, build-time, Vite) ------------------------------
# Only needed when the frontend is hosted separately from the backend.
# VITE_SERVER_URL=https://api.example.com
# VITE_API_URL=https://api.example.com
# Dev proxy target used by `vite` (default http://localhost:4000).
# VITE_DEV_API=http://localhost:4000
